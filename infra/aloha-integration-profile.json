{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "profileVersion": 2,
  "status": "candidate",
  "trackingIssue": 162,
  "application": {
    "key": "aloha-assistant",
    "stagingId": "aloha-assistant-staging",
    "productionId": "aloha-assistant",
    "clientType": "web",
    "trustedBackend": true,
    "accessTokenTtlSeconds": 900,
    "allowedUserScopes": [
      "profile:read",
      "resources:read"
    ]
  },
  "trustedBackend": {
    "credentialType": "lsa_application_credential",
    "credentialLocation": "server_only",
    "identityExchangePath": "/internal/v1/access/tokens",
    "transportPolicy": "https_or_same_account_service_binding_with_explicit_application_authentication",
    "providerIdentityOwner": "lifespace-identity",
    "providerIdentityMapping": "cloudflare_access_issuer_subject_to_lifespace_user_id"
  },
  "cloudflareAccess": {
    "required": true,
    "audienceRegistration": "required",
    "audienceValueLocation": "deployment_only"
  },
  "agentIdentity": {
    "required": true,
    "displayName": "ALOHA Assistant",
    "applicationBinding": "same_application",
    "activeAgentCardinality": 1,
    "executionTokenPurpose": "delegated_agent",
    "m3RequestedScopes": [],
    "m4RequestedScopes": [
      "resources:read"
    ]
  },
  "coreAuthority": {
    "m3ModelAccess": {},
    "m3DelegationRequired": false,
    "futureExpansion": "Mutation/action authority is deferred to ALOHA M5 and requires its Confirmation boundary; M4 remains Task read-only.",
    "m4ModelAccess": {
      "task": "read"
    },
    "m4DelegationRequired": true,
    "m4DelegationModels": [
      {
        "modelKey": "task",
        "maxAccess": "read"
      }
    ],
    "m4RuntimeDiscovery": "authoritative",
    "m4WriteAuthority": false
  },
  "contracts": {
    "identity": "0.6.0",
    "coreKernel": "0.37.0",
    "modelContract": null,
    "pinStatus": "candidate"
  },
  "runtimeToolBoundary": {
    "m4Operations": [
      "discover",
      "query",
      "get"
    ],
    "delegatedTokenConsumer": "aloha-agent-control",
    "n8nReceivesLifeSpaceCredential": false,
    "n8nReceivesDelegatedAgentToken": false
  }
}
