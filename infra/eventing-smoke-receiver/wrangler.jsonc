{
  "$schema": "../../apps/core/node_modules/wrangler/config-schema.json",
  "name": "lifespace-eventing-smoke-staging",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-08",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "eventing-smoke-staging.aisr.online",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSIONS",
        "class_name": "EventingSmokeSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "EventingSmokeSession"
      ]
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "head_sampling_rate": 1
    }
  }
}
