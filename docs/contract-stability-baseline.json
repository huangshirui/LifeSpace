{
  "schemaVersion": 1,
  "maturityValues": ["stable", "candidate", "experimental"],
  "visibilityValues": ["public", "internal"],
  "semanticInvariants": [
    {
      "id": "space-boundary",
      "maturity": "stable",
      "visibility": "public",
      "commitment": "Every ordinary record has one source Space; Spaces are isolated by default and cross-Space sharing is explicit, bounded, revocable and ownership-preserving."
    },
    {
      "id": "global-user-identity",
      "maturity": "stable",
      "visibility": "public",
      "commitment": "A LifeSpace user identity is global across applications; application/provider identities are mappings rather than parallel LifeSpace users."
    },
    {
      "id": "principal-actor-application-attribution",
      "maturity": "stable",
      "visibility": "public",
      "commitment": "Principal authority, executing Actor and Application Context remain distinguishable and attributable when they differ."
    },
    {
      "id": "effective-authority-intersection",
      "maturity": "stable",
      "visibility": "public",
      "commitment": "Effective authority never exceeds verified credential scope, Application × Model Access, current Space membership/Data Grant, published model capability/policy and current Delegation when acting as a delegated Agent."
    },
    {
      "id": "model-semantic-ownership",
      "maturity": "stable",
      "visibility": "public",
      "commitment": "Canonical Model Definitions/Registry own ordinary model semantics; generated Model Contracts and protocol adapters are projections rather than second semantic sources."
    },
    {
      "id": "generic-runtime-fundamentals",
      "maturity": "stable",
      "visibility": "public",
      "commitment": "Validation, declared server defaults, optimistic concurrency, Action semantic input and Mutation Authority are enforced by the Runtime rather than left to clients."
    },
    {
      "id": "governed-change-attribution",
      "maturity": "stable",
      "visibility": "public",
      "commitment": "Committed ordinary-model mutations preserve governed Change evidence including operation/resource/version and Principal, Actor, Application and Delegation attribution where applicable."
    },
    {
      "id": "current-state-revocation",
      "maturity": "stable",
      "visibility": "public",
      "commitment": "Mutable Membership, Data Grant, Application × Model Access, Service Principal and Agent Delegation authority is checked from current state so stale credentials do not preserve revoked authority."
    },
    {
      "id": "agent-protocol-independence",
      "maturity": "stable",
      "visibility": "public",
      "commitment": "Agent readiness is protocol/product independent; REST, MCP, API Tool, n8n, SDK, ALOHA and future adapters must project the same authority and model semantics."
    }
  ],
  "stableLocks": {
    "semanticInvariants": [
      "space-boundary",
      "global-user-identity",
      "principal-actor-application-attribution",
      "effective-authority-intersection",
      "model-semantic-ownership",
      "generic-runtime-fundamentals",
      "governed-change-attribution",
      "current-state-revocation",
      "agent-protocol-independence"
    ],
    "operationGroups": [
      "identity-application/identity-profile",
      "identity-application/identity-trusted-application-exchange",
      "identity-application/identity-service-authentication",
      "identity-application/identity-core-introspection",
      "core-kernel/core-principal-space-context",
      "core-kernel/core-space-membership",
      "core-kernel/core-data-grants"
    ]
  },
