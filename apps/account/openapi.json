          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "No Access session"
          },
          "403": {
            "description": "CSRF, scope or current Core/Identity authority denied"
          },
          "409": {
            "description": "Changed version or no longer available"
          },
          "502": {
            "description": "Invalid upstream response"
          },
          "503": {
            "description": "Upstream unavailable"
          }
        }
      }
    },
