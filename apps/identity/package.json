{
  "name": "@lifespace/identity",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "contract": "node scripts/check-openapi.mjs && node scripts/check-platform-admin-openapi.mjs",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "check": "pnpm contract && pnpm test && pnpm typecheck && pnpm build",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:staging": "wrangler d1 migrations apply DB --remote --env staging",
    "db:migrate:production": "wrangler d1 migrations apply DB --remote --env production"
  },
  "dependencies": { "hono": "^4.10.0" },
  "devDependencies": { "@cloudflare/vitest-pool-workers": "^0.16.20", "@cloudflare/workers-types": "^4.20260702.1", "@types/node": "^24.0.0", "typescript": "^5.9.0", "vitest": "^4.1.0", "wrangler": "4.105.0", "yaml": "^2.9.0" }
}
