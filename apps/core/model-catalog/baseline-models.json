{
  "task": {
    "definitionVersion": 1,
    "key": "task",
    "description": "Actionable work that someone intends or needs to complete. Use for chores, errands, reminders, follow-ups, purchases, submissions, calls, and other concrete to-dos. A due date is a deadline, not a scheduled time block. Do not use for an event merely because it has a date, or for a future aspiration with no concrete commitment. Examples: 明天交电费；提醒我买牛奶；周五前提交报告。",
    "display": {
      "singular": "Task",
      "plural": "Tasks"
    },
    "fields": {
      "name": {
        "type": "string",
        "title": "Name",
        "description": "The concrete action or to-do to complete.",
        "required": true,
        "minLength": 1,
        "maxLength": 100
      },
      "description": {
        "type": "text",
        "title": "Description",
        "description": "Supporting details about how or why to complete the task.",
        "nullable": true,
        "maxLength": 5000
      },
      "dueDate": {
        "type": "date",
        "title": "Due Date",
        "description": "The deadline date for completing the task, not a calendar time block.",
        "nullable": true
      },
      "status": {
        "type": "enum",
        "title": "Status",
        "description": "Current lifecycle state of the task.",
        "required": true,
        "readOnly": true,
        "values": [
          "pending",
          "completed",
          "cancelled"
        ]
      },
      "assigneePersonIds": {
        "type": "person_list",
        "title": "Assignees",
        "description": "People responsible for completing the task."
      },
      "completedAt": {
        "type": "datetime",
        "title": "Completed At",
        "description": "When the task was completed, set by the authoritative completion Action.",
        "nullable": true,
        "readOnly": true
      },
      "completedByType": {
        "type": "enum",
        "title": "Completed By Type",
        "description": "Type of Actor that completed the task, set by the authoritative completion Action.",
        "nullable": true,
        "readOnly": true,
        "values": [
          "user",
          "service",
          "device",
          "agent"
        ]
      },
      "completedById": {
        "type": "string",
        "title": "Completed By",
        "description": "Identifier of the Actor that completed the task, set by the authoritative completion Action.",
        "nullable": true,
        "readOnly": true,
        "maxLength": 100
      },
      "subject": {
        "type": "entity_ref",
        "title": "Subject",
        "description": "Business subject of the work: a Space Person or native Record.",
        "nullable": true
      },
      "recurrenceOccurrenceId": {
        "type": "string",
        "title": "Recurrence Occurrence",
        "description": "Platform-owned stable occurrence identity for generated tasks.",
        "readOnly": true,
        "immutable": true,
        "nullable": true
      }
    },
    "defaults": {
      "status": "pending"
    },
    "query": {
      "searchable": [
        "name",
        "description"
      ],
      "filterable": [
        "status",
        "dueDate",
        "assigneePersonIds"
      ],
      "sortable": [
        "dueDate",
        "name"
      ]
    },
    "access": [
      "read",
      "write"
    ],
    "lifecycle": {
      "optimisticConcurrency": true,
      "softDelete": true
    },
    "actions": {
      "complete": {
        "access": "write",
        "guards": [
          {
            "field": "status",
            "op": "neq",
            "value": "completed",
            "errorCode": "TASK_ALREADY_COMPLETED",
            "message": "Task is already completed"
          }
        ],
        "set": {
          "status": "completed",
          "completedAt": {
            "$ref": "now"
          },
          "completedByType": {
            "$ref": "actor.type"
          },
          "completedById": {
            "$ref": "actor.id"
          }
        }
      },
      "cancel": {
        "access": "write",
        "guards": [
          {
            "field": "status",
            "op": "neq",
            "value": "cancelled",
            "errorCode": "TASK_ALREADY_CANCELLED",
            "message": "Task is already cancelled"
          }
        ],
        "set": {
          "status": "cancelled",
          "completedAt": null,
          "completedByType": null,
          "completedById": null
        }
      },
      "reopen": {
        "access": "write",
        "guards": [
          {
            "field": "status",
            "op": "neq",
            "value": "pending",
            "errorCode": "TASK_ALREADY_PENDING",
            "message": "Task is already pending"
          }
        ],
        "set": {
          "status": "pending",
          "completedAt": null,
          "completedByType": null,
          "completedById": null
        }
      },
      "skip-occurrence": {
        "access": "write",
        "guards": [
          {
            "field": "recurrenceOccurrenceId",
            "op": "neq",
            "value": null,
            "errorCode": "ACTION_NOT_AVAILABLE",
            "message": "Only generated Tasks have a recurrence occurrence"
          }
        ],
        "set": {
          "status": "cancelled",
          "completedAt": null,
          "completedByType": null,
          "completedById": null
        }
      }
    },
    "semanticRelations": {
      "outgoing": [
        "generated_from"
      ]
    }
  },
  "wish": {
    "definitionVersion": 1,
    "key": "wish",
    "description": "An aspiration, desire, or hoped-for future experience or thing that the user wants but has not committed to as a concrete task or scheduled event. Use for bucket-list items, dreams, desired purchases, and hoped-for experiences. Never use Wish as a fallback merely because its schema is broad or another model has missing fields. Examples: 想去冰岛看极光；希望以后有一台房车；想学会潜水。",
    "display": {
      "singular": "Wish",
      "plural": "Wishes"
    },
    "fields": {
      "title": {
        "type": "string",
        "title": "Title",
        "description": "A concise statement of the aspiration or desired outcome.",
        "required": true,
        "minLength": 1,
        "maxLength": 100
      },
      "description": {
        "type": "text",
        "title": "Description",
        "description": "Optional detail about the aspiration and why it is desired.",
        "nullable": true,
        "maxLength": 5000
      },
      "desiredDate": {
        "type": "date",
        "title": "Desired Date",
        "description": "A hoped-for date, not a committed task deadline or scheduled event time.",
        "nullable": true
      },
      "status": {
        "type": "enum",
        "title": "Status",
        "description": "Whether the wish is still waiting to happen or has been fulfilled.",
        "required": true,
        "readOnly": true,
        "values": [
          "open",
          "fulfilled"
        ]
      },
      "ownerPersonId": {
        "type": "person",
        "title": "Owner",
        "description": "The person whose aspiration this is.",
        "required": true,
        "immutable": true
      },
      "fulfilledAt": {
        "type": "datetime",
        "title": "Fulfilled At",
        "description": "When the wish was marked fulfilled.",
        "nullable": true,
        "readOnly": true
      }
    },
    "defaults": {
      "status": "open"
    },
    "query": {
      "searchable": [
        "title",
        "description"
      ],
      "filterable": [
        "status",
        "ownerPersonId",
        "desiredDate"
      ],
      "sortable": [
        "desiredDate",
        "title"
      ]
    },
    "access": [
      "read",
      "write"
    ],
    "lifecycle": {
      "optimisticConcurrency": true,
      "softDelete": true
    },
    "policies": {
      "create": {
        "all": [
          {
            "op": "neq",
            "left": {
              "$ref": "principal.personId"
            },
            "right": {
              "value": null
            }
          },
          {
            "op": "eq",
            "left": {
              "$ref": "input.ownerPersonId"
            },
            "right": {
              "$ref": "principal.personId"
            }
          }
        ]
      },
      "read": {
        "op": "neq",
        "left": {
          "$ref": "principal.personId"
        },
        "right": {
          "value": null
        }
      },
      "update": {
        "op": "eq",
        "left": {
          "$ref": "record.ownerPersonId"
        },
        "right": {
          "$ref": "principal.personId"
        }
      },
      "delete": {
        "op": "eq",
        "left": {
          "$ref": "record.ownerPersonId"
        },
        "right": {
          "$ref": "principal.personId"
        }
      }
    },
    "actions": {
      "fulfill": {
        "access": "write",
        "policy": {
          "op": "neq",
          "left": {
            "$ref": "principal.personId"
          },
          "right": {
            "value": null
          }
        },
        "guards": [
          {
            "field": "status",
            "op": "eq",
            "value": "open",
            "errorCode": "WISH_NOT_OPEN",
            "message": "Only open wishes can be fulfilled"
          }
        ],
        "set": {
          "status": "fulfilled",
          "fulfilledAt": {
            "$ref": "now"
          }
        }
      },
      "reopen": {
        "access": "write",
        "policy": {
          "op": "neq",
          "left": {
            "$ref": "principal.personId"
          },
          "right": {
            "value": null
          }
        },
        "guards": [
          {
            "field": "status",
            "op": "eq",
            "value": "fulfilled",
            "errorCode": "WISH_NOT_FULFILLED",
            "message": "Only fulfilled wishes can be reopened"
          }
        ],
        "set": {
          "status": "open",
          "fulfilledAt": null
        }
      }
    }
  },
  "day_record": {
    "definitionVersion": 1,
    "key": "day_record",
    "description": "A date-anchored tracker for counting elapsed days, counting down to a date, or representing a recurring/cycle interval. Use for since/until counters, milestones anchored to a date, streaks, and cycle tracking. Do not use for ordinary appointments, one-off calendar occurrences, or concrete to-dos. Examples: 从今天开始戒糖；距离生日还有多少天；每28天一个周期。",
    "display": {
      "singular": "Day Record",
      "plural": "Day Records"
    },
    "fields": {
      "name": {
        "type": "string",
        "title": "Name",
        "description": "The milestone, streak, countdown, or cycle being tracked.",
        "required": true,
        "minLength": 1,
        "maxLength": 100
      },
      "description": {
        "type": "text",
        "title": "Description",
        "description": "Optional context about the tracked date or cycle.",
        "nullable": true,
        "maxLength": 5000
      },
      "kind": {
        "type": "enum",
        "title": "Kind",
        "description": "Tracker mode: elapsed since anchorDate, countdown until anchorDate, or recurring cycle.",
        "required": true,
        "immutable": true,
        "values": [
          "elapsed",
          "countdown",
          "cycle"
        ]
      },
      "anchorDate": {
        "type": "date",
        "title": "Anchor Date",
        "description": "The calendar date that anchors the elapsed, countdown, or cycle calculation.",
        "required": true
      },
      "subjectPersonId": {
        "type": "person",
        "title": "Subject",
        "description": "Optional person the tracked date or cycle belongs to.",
        "nullable": true
      },
      "attentionAfterDays": {
        "type": "integer",
        "title": "Attention After Days",
        "description": "Number of days after the anchor date when the record should enter an attention window.",
        "nullable": true,
        "minimum": 1
      },
      "attentionBeforeDays": {
        "type": "integer",
        "title": "Attention Before Days",
        "description": "Number of days before the anchor date when the record should enter an attention window.",
        "nullable": true,
        "minimum": 0
      },
      "cycleDays": {
        "type": "integer",
        "title": "Cycle Days",
        "description": "Length in days for a recurring cycle.",
        "nullable": true,
        "minimum": 1
      },
      "status": {
        "type": "enum",
        "title": "Status",
        "description": "Current lifecycle state of the day record.",
        "required": true,
        "readOnly": true,
        "values": [
          "active",
          "archived"
        ]
      }
    },
    "query": {
      "searchable": [
        "name",
        "description"
      ],
      "filterable": [
        "kind",
        "status",
        "subjectPersonId",
        "anchorDate"
      ],
      "sortable": [
        "anchorDate",
        "name"
      ]
    },
    "access": [
      "read",
      "write"
    ],
    "lifecycle": {
      "optimisticConcurrency": true,
      "softDelete": true
    },
    "capabilities": {
      "temporal": {
        "kindField": "kind",
        "anchorDateField": "anchorDate",
        "cycleDaysField": "cycleDays",
        "attentionBeforeDaysField": "attentionBeforeDays",
        "attentionAfterDaysField": "attentionAfterDays",
        "statusField": "status",
        "subjectPersonField": "subjectPersonId",
        "occurrences": true
      }
    },
    "actions": {
      "archive": {
        "access": "write",
        "guards": [
          {
            "field": "status",
            "op": "neq",
            "value": "archived",
            "errorCode": "DAY_RECORD_ARCHIVED",
            "message": "Day record is already archived"
          }
        ],
        "set": {
          "status": "archived"
        }
      },
      "restore": {
        "access": "write",
        "guards": [
          {
            "field": "status",
            "op": "neq",
            "value": "active",
            "errorCode": "DAY_RECORD_ALREADY_ACTIVE",
            "message": "Day record is already active"
          }
        ],
        "set": {
          "status": "active"
        }
      }
    }
  },
  "event": {
    "definitionVersion": 1,
    "key": "event",
    "description": "A calendar occurrence that happens or is planned for a specific date or time and may occupy time or involve attendance or a location. Use for meetings, appointments, classes, matches, meals, celebrations, and other things that occur. Do not use merely because a task has a deadline. Examples: 周六上午十点足球比赛；明晚七点和王老师吃饭；8月30日体检。",
    "display": {
      "singular": "Event",
      "plural": "Events"
    },
    "fields": {
      "summary": {
        "type": "string",
        "title": "Summary",
        "description": "A concise name for the calendar occurrence.",
        "required": true,
        "minLength": 1,
        "maxLength": 100
      },
      "description": {
        "type": "text",
        "title": "Description",
        "description": "Optional details about the occurrence.",
        "nullable": true,
        "maxLength": 5000
      },
      "location": {
        "type": "string",
        "title": "Location",
        "description": "Where the occurrence happens, when explicitly provided.",
        "nullable": true,
        "maxLength": 500
      },
      "when": {
        "type": "temporal_range",
        "title": "When",
        "description": "When the occurrence happens. Use the date variant for all-day/date-only events and the instant variant for timed events.",
        "required": true
      },
      "attendeePersonIds": {
        "type": "person_list",
        "title": "Attendees",
        "description": "People attending or participating in the occurrence."
      },
      "status": {
        "type": "enum",
        "title": "Status",
        "description": "Current lifecycle state of the event.",
        "required": true,
        "values": [
          "active",
          "cancelled"
        ]
      }
    },
    "defaults": {
      "status": "active"
    },
    "query": {
      "searchable": [
        "summary",
        "description",
        "location"
      ],
      "filterable": [
        "status",
        "when",
        "attendeePersonIds"
      ],
      "sortable": [
        "when",
        "summary"
      ]
    },
    "access": [
      "read",
      "write"
    ],
    "lifecycle": {
      "optimisticConcurrency": true,
      "softDelete": true
    },
    "capabilities": {
      "calendar": {
        "rangeField": "when",
        "attendeePersonField": "attendeePersonIds"
      }
    }
  },
  "person_group": {
    "definitionVersion": 1,
    "key": "person_group",
    "description": "Named group of Space People (e.g. team, family, classmates); membership grants no authority and implies no typed relationship.",
    "display": {
      "singular": "Person Group",
      "plural": "Person Groups"
    },
    "fields": {
      "name": {
        "type": "string",
        "title": "Name",
        "description": "Name of this group.",
        "required": true,
        "minLength": 1,
        "maxLength": 100
      },
      "description": {
        "type": "text",
        "title": "Description",
        "description": "Optional group context.",
        "nullable": true,
        "maxLength": 2000
      },
      "memberPersonIds": {
        "type": "person_list",
        "title": "Members",
        "description": "Space People included in the group."
      }
    },
    "referenceLabel": {
      "field": "name"
    },
    "query": {
      "searchable": [
        "name",
        "description"
      ],
      "filterable": [
        "memberPersonIds"
      ],
      "sortable": [
        "name"
      ]
    },
    "access": [
      "read",
      "write"
    ],
    "lifecycle": {
      "optimisticConcurrency": true,
      "softDelete": true
    }
  },
  "anniversary": {
    "definitionVersion": 1,
    "key": "anniversary",
    "description": "A meaningful date observed annually (e.g., birthday or wedding anniversary), with an optional original year; a scheduled celebration belongs to Event.",
    "display": {
      "singular": "Anniversary",
      "plural": "Anniversaries"
    },
    "fields": {
      "name": {
        "type": "string",
        "title": "Name",
        "required": true,
        "minLength": 1,
        "maxLength": 150,
        "description": "Name of the annual occasion."
      },
      "description": {
        "type": "text",
        "title": "Description",
        "nullable": true,
        "maxLength": 5000,
        "description": "Optional context for this occasion."
      },
      "personIds": {
        "type": "person_list",
        "title": "People",
        "description": "People linked to the occasion; may be several."
      },
      "month": {
        "type": "integer",
        "title": "Month",
        "required": true,
        "minimum": 1,
        "maximum": 12,
        "description": "Annual calendar month (1–12)."
      },
      "day": {
        "type": "integer",
        "title": "Day",
        "required": true,
        "minimum": 1,
        "maximum": 31,
        "description": "Valid day of the specified month."
      },
      "year": {
        "type": "integer",
        "title": "Original Year",
        "nullable": true,
        "minimum": 1,
        "maximum": 9999,
        "description": "Original year, if known; omit for month/day-only occasions."
      }
    },
    "referenceLabel": {
      "field": "name"
    },
    "query": {
      "searchable": [
        "name",
        "description"
      ],
      "filterable": [
        "personIds",
        "month",
        "day",
        "year"
      ],
      "sortable": [
        "month",
        "day",
        "name"
      ]
    },
    "access": [
      "read",
      "write"
    ],
    "lifecycle": {
      "optimisticConcurrency": true,
      "softDelete": true
    }
  },
  "activity": {
    "definitionVersion": 1,
    "key": "activity",
    "description": "A shared undertaking such as a trip, camp or competition, possibly spanning days; groups related records. Not a single Event or desired Goal.",
    "display": {
      "singular": "Activity",
      "plural": "Activities"
    },
    "fields": {
      "name": {
        "type": "string",
        "title": "Name",
        "required": true,
        "minLength": 1,
        "maxLength": 150,
        "description": "Name of the activity."
      },
      "description": {
        "type": "text",
        "title": "Description",
        "nullable": true,
        "maxLength": 5000,
        "description": "Optional purpose or context."
      },
      "attendeePersonIds": {
        "type": "person_list",
        "title": "Attendees",
        "description": "People involved; may be empty."
      },
      "startDate": {
        "type": "date",
        "title": "Start Date",
        "nullable": true,
        "description": "First date, if known."
      },
      "endDate": {
        "type": "date",
        "title": "End Date",
        "nullable": true,
        "description": "Last date, if known."
      }
    },
    "referenceLabel": {
      "field": "name"
    },
    "query": {
      "searchable": [
        "name",
        "description"
      ],
      "filterable": [
        "attendeePersonIds",
        "startDate",
        "endDate"
      ],
      "sortable": [
        "startDate",
        "endDate",
        "name"
      ]
    },
    "access": [
      "read",
      "write"
    ],
    "lifecycle": {
      "optimisticConcurrency": true,
      "softDelete": true
    },
    "semanticRelations": {
      "outgoing": [
        "relates_to"
      ]
    }
  },
  "goal": {
    "definitionVersion": 1,
    "key": "goal",
    "description": "An outcome pursued over time by one or more people, optionally with a target date; not a single Task or scheduled Event.",
    "display": {
      "singular": "Goal",
      "plural": "Goals"
    },
    "fields": {
      "name": {
        "type": "string",
        "title": "Name",
        "required": true,
        "minLength": 1,
        "maxLength": 150,
        "description": "Desired outcome to achieve."
      },
      "description": {
        "type": "text",
        "title": "Description",
        "nullable": true,
        "maxLength": 5000,
        "description": "Optional motivation or success criteria."
      },
      "subjectPersonIds": {
        "type": "person_list",
        "title": "People",
        "description": "People pursuing the goal, individually or together."
      },
      "startDate": {
        "type": "date",
        "title": "Start Date",
        "nullable": true,
        "description": "Date pursuit begins, if known."
      },
      "targetDate": {
        "type": "date",
        "title": "Target Date",
        "nullable": true,
        "description": "Desired completion date, not an appointment."
      },
      "status": {
        "type": "enum",
        "title": "Status",
        "description": "The current lifecycle state of the goal, controlled by explicit actions rather than ordinary updates.",
        "required": true,
        "readOnly": true,
        "values": [
          "active",
          "paused",
          "achieved",
          "abandoned"
        ]
      }
    },
    "referenceLabel": {
      "field": "name"
    },
    "query": {
      "searchable": [
        "name",
        "description"
      ],
      "filterable": [
        "subjectPersonIds",
        "startDate",
        "targetDate",
        "status"
      ],
      "sortable": [
        "targetDate",
        "name"
      ]
    },
    "access": [
      "read",
      "write"
    ],
    "lifecycle": {
      "optimisticConcurrency": true,
      "softDelete": true
    },
    "semanticRelations": {
      "outgoing": [
        "relates_to"
      ]
    },
    "defaults": {
      "status": "active"
    },
    "actions": {
      "pause": {
        "access": "write",
        "guards": [
          {
            "field": "status",
            "op": "eq",
            "value": "active",
            "errorCode": "GOAL_NOT_ACTIVE"
          }
        ],
        "set": {
          "status": "paused"
        }
      },
      "resume": {
        "access": "write",
        "guards": [
          {
            "field": "status",
            "op": "eq",
            "value": "paused",
            "errorCode": "GOAL_NOT_PAUSED"
          }
        ],
        "set": {
          "status": "active"
        }
      },
      "achieve": {
        "access": "write",
        "guards": [
          {
            "field": "status",
            "op": "neq",
            "value": "achieved"
          },
          {
            "field": "status",
            "op": "neq",
            "value": "abandoned"
          }
        ],
        "set": {
          "status": "achieved"
        }
      },
      "abandon": {
        "access": "write",
        "guards": [
          {
            "field": "status",
            "op": "neq",
            "value": "abandoned"
          },
          {
            "field": "status",
            "op": "neq",
            "value": "achieved"
          }
        ],
        "set": {
          "status": "abandoned"
        }
      },
      "reopen": {
        "access": "write",
        "guards": [
          {
            "field": "status",
            "op": "neq",
            "value": "active"
          },
          {
            "field": "status",
            "op": "neq",
            "value": "paused"
          }
        ],
        "set": {
          "status": "active"
        }
      }
    }
  },
  "person_profile": {
    "definitionVersion": 1,
    "key": "person_profile",
    "description": "One attribute, preference or background fact about a known Person; not identity/authorization, a dated event or a diary entry.",
    "display": {
      "singular": "Person Profile",
      "plural": "Person Profile Entries"
    },
    "fields": {
      "personId": {
        "type": "person",
        "title": "Person",
        "required": true,
        "immutable": true,
        "description": "Person described by this fact."
      },
      "key": {
        "type": "string",
        "title": "Key",
        "required": true,
        "minLength": 1,
        "maxLength": 120,
        "description": "Attribute name, e.g. education or clothing size."
      },
      "value": {
        "type": "text",
        "title": "Value",
        "required": true,
        "maxLength": 5000,
        "description": "Value or explanation of this attribute.",
        "minLength": 1
      }
    },
    "referenceLabel": {
      "field": "key"
    },
    "query": {
      "searchable": [
        "key",
        "value"
      ],
      "filterable": [
        "personId",
        "key"
      ],
      "sortable": [
        "key"
      ]
    },
    "access": [
      "read",
      "write"
    ],
    "lifecycle": {
      "optimisticConcurrency": true,
      "softDelete": true
    }
  },
  "habit": {
    "definitionVersion": 1,
    "key": "habit",
    "description": "An ongoing behavior tracked through check-ins and streaks; not a one-off Task, scheduled Event, DayRecord counter or desired Goal.",
    "display": {
      "singular": "Habit",
      "plural": "Habits"
    },
    "fields": {
      "name": {
        "type": "string",
        "title": "Name",
        "required": true,
        "minLength": 1,
        "maxLength": 150,
        "description": "Behavior to maintain over time."
      },
      "description": {
        "type": "text",
        "title": "Description",
        "nullable": true,
        "maxLength": 3000,
        "description": "Optional practice details or motivation."
      },
      "intervalDays": {
        "type": "integer",
        "title": "Check-in Interval (days)",
        "required": true,
        "immutable": true,
        "minimum": 1,
        "maximum": 365,
        "description": "Max calendar-day gap between check-ins that preserves a streak; 1=daily. Fixed after creation."
      },
      "lastCheckInDate": {
        "type": "date",
        "title": "Last Check-in Date",
        "readOnly": true,
        "nullable": true,
        "description": "Latest check-in date in Space local time; null before first check-in."
      },
      "streakStartDate": {
        "type": "date",
        "title": "Streak Start Date",
        "readOnly": true,
        "nullable": true,
        "description": "First date of the latest unbroken check-in sequence."
      },
      "subjectPersonId": {
        "type": "person",
        "title": "Practicing Person",
        "description": "The one Space Person responsible for this habit and its check-ins, fixed when the habit is created.",
        "required": true,
        "immutable": true
      },
      "status": {
        "type": "enum",
        "title": "Status",
        "description": "Lifecycle state of this practice; only active habits may record check-ins.",
        "required": true,
        "readOnly": true,
        "values": [
          "active",
          "paused",
          "ended"
        ]
      }
    },
    "defaults": {
      "intervalDays": 1,
      "status": "active"
    },
    "referenceLabel": {
      "field": "name"
    },
    "query": {
      "searchable": [
        "name",
        "description"
      ],
      "filterable": [
        "intervalDays",
        "status",
        "subjectPersonId"
      ],
      "sortable": [
        "name"
      ]
    },
    "access": [
      "read",
      "write"
    ],
    "lifecycle": {
      "optimisticConcurrency": true,
      "softDelete": true
    },
    "capabilities": {
      "checkIn": {
        "intervalDaysField": "intervalDays",
        "lastCheckInDateField": "lastCheckInDate",
        "streakStartDateField": "streakStartDate",
        "statusField": "status",
        "allowedStatuses": [
          "active"
        ]
      }
    },
    "semanticRelations": {
      "outgoing": [
        "relates_to"
      ]
    },
    "policies": {
      "update": {
        "all": [
          {
            "op": "neq",
            "left": {
              "$ref": "principal.personId"
            },
            "right": {
              "value": null
            }
          },
          {
            "op": "eq",
            "left": {
              "$ref": "principal.personId"
            },
            "right": {
              "$ref": "record.subjectPersonId"
            }
          }
        ]
      },
      "delete": {
        "all": [
          {
            "op": "neq",
            "left": {
              "$ref": "principal.personId"
            },
            "right": {
              "value": null
            }
          },
          {
            "op": "eq",
            "left": {
              "$ref": "principal.personId"
            },
            "right": {
              "$ref": "record.subjectPersonId"
            }
          }
        ]
      }
    },
    "actions": {
      "pause": {
        "access": "write",
        "guards": [
          {
            "field": "status",
            "op": "eq",
            "value": "active",
            "errorCode": "HABIT_NOT_ACTIVE"
          }
        ],
        "set": {
          "status": "paused"
        },
        "policy": {
          "all": [
            {
              "op": "neq",
              "left": {
                "$ref": "principal.personId"
              },
              "right": {
                "value": null
              }
            },
            {
              "op": "eq",
              "left": {
                "$ref": "principal.personId"
              },
              "right": {
                "$ref": "record.subjectPersonId"
              }
            }
          ]
        }
      },
      "resume": {
        "access": "write",
        "guards": [
          {
            "field": "status",
            "op": "eq",
            "value": "paused",
            "errorCode": "HABIT_NOT_PAUSED"
          }
        ],
        "set": {
          "status": "active"
        },
        "policy": {
          "all": [
            {
              "op": "neq",
              "left": {
                "$ref": "principal.personId"
              },
              "right": {
                "value": null
              }
            },
            {
              "op": "eq",
              "left": {
                "$ref": "principal.personId"
              },
              "right": {
                "$ref": "record.subjectPersonId"
              }
            }
          ]
        }
      },
      "end": {
        "access": "write",
        "policy": {
          "all": [
            {
              "op": "neq",
              "left": {
                "$ref": "principal.personId"
              },
              "right": {
                "value": null
              }
            },
            {
              "op": "eq",
              "left": {
                "$ref": "principal.personId"
              },
              "right": {
                "$ref": "record.subjectPersonId"
              }
            }
          ]
        },
        "guards": [
          {
            "field": "status",
            "op": "neq",
            "value": "ended",
            "errorCode": "HABIT_ALREADY_ENDED"
          }
        ],
        "set": {
          "status": "ended"
        }
      },
      "reopen": {
        "access": "write",
        "guards": [
          {
            "field": "status",
            "op": "eq",
            "value": "ended",
            "errorCode": "HABIT_NOT_ENDED"
          }
        ],
        "set": {
          "status": "active"
        },
        "policy": {
          "all": [
            {
              "op": "neq",
              "left": {
                "$ref": "principal.personId"
              },
              "right": {
                "value": null
              }
            },
            {
              "op": "eq",
              "left": {
                "$ref": "principal.personId"
              },
              "right": {
                "$ref": "record.subjectPersonId"
              }
            }
          ]
        }
      }
    }
  }
}
