{
  "name": "@lifespace/console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "typecheck": "tsc --noEmit",
    "build": "vite build && node --check dist/lifespace_console_local/index.js",
    "check:staging-isolation": "node scripts/check-staging-deploy-isolation.mjs",
    "check:production-isolation": "node scripts/check-production-deploy-isolation.mjs",
    "check:control-plane": "node scripts/check-control-plane-boundary.mjs",
    "check:application-config": "node scripts/check-application-configuration-boundary.mjs",
    "check:agent-governance": "node scripts/check-agent-governance-boundary.mjs",
    "check:credential-governance": "node scripts/check-credential-governance-boundary.mjs",
    "check:credential-reveal": "node scripts/check-credential-reveal-boundary.mjs",
    "check": "pnpm typecheck && pnpm check:control-plane && pnpm check:application-config && pnpm check:agent-governance && pnpm check:credential-governance && pnpm check:credential-reveal && pnpm check:staging-isolation && pnpm check:production-isolation && pnpm build",
    "deploy:staging": "CLOUDFLARE_ENV=staging vite build && wrangler deploy",
    "deploy:production": "CLOUDFLARE_ENV=production vite build && wrangler deploy"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.53.1",
    "@cloudflare/workers-types": "5.20260820.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.125.0"
  }
}
